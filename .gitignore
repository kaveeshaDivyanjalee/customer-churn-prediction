# Project specific - CRITICAL SECTION
# We NEED the model for deployment, so DON'T ignore it!
# The lines below are commented out to ALLOW these files
# models/churn_model.pkl         ← ALLOWED (needed for app)
# models/model_evaluation.png    ← ALLOWED (needed for app)

# Data files - Keep dataset private, but allow model
data/Telco_Customer_Churn_Expanded.xlsx
data/*.csv
data/*.json
data/*.parquet
data/*.feather

# IMPORTANT: Do NOT ignore .pkl files in models/ folder!
# We use a more specific pattern below to only ignore pickles elsewhere
# *.pkl                           ← REMOVED (was blocking model)
# *.joblib                        ← REMOVED (was blocking model)
*.pickle

# Allow models folder content explicitly
!models/*.pkl
!models/*.png
!models/*.joblib

# Streamlit secrets only (not config)
.streamlit/secrets.toml

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Specific data files in root only (not in subdirectories)
/*.xlsx
/*.json

# MLflow
mlruns/
mlflow/

# DVC
.dvc/
.dvcignore

# Output files (but not models!)
output/
results/
predictions/
reports/